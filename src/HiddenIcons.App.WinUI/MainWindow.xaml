<Window
    x:Class="HiddenIcons.AppWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HiddenIcons.AppWin"
    Title="Hidden Icons 管理器">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（内容延伸进 Mica，拖拽区即标题栏） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <TextBlock Text="Hidden Icons 管理器"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="13" />
        </Grid>

        <Grid Grid.Row="1" Padding="20,0,20,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="LoadFailBar"
                     Grid.Row="0"
                     IsOpen="False"
                     Severity="Warning"
                     Title="配置读取失败"
                     Message="为避免覆盖现有配置，关闭窗口时不会自动保存；手动点击「保存配置」才会写入。" />

            <!-- 命令区：与旧版相同的四个动作 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="BtnAdd" Click="AddProfile_Click" ToolTipService.ToolTip="选择一个 exe 加入列表">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="添加程序" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRemove" Click="RemoveProfile_Click" ToolTipService.ToolTip="删除选中的条目">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="删除" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSave" Click="Save_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="保存配置" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSettings" Click="TaskbarSettings_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7EE;" FontSize="14" />
                        <TextBlock Text="打开系统托盘设置" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 卡片式 profile 列表 -->
            <ListView x:Name="ProfileList"
                      Grid.Row="2"
                      SelectionMode="Single"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <!-- 用运行时 {Binding} 而非 x:Bind：dotnet CLI 下 XAML 编译器 Pass2
                         拿不到本地程序集（WMC1509），x:DataType 会解析失败 -->
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12">
                            <Grid RowSpacing="10" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0"
                                         Header="名称"
                                         Text="{Binding Name, Mode=TwoWay}" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Header="加载模式"
                                          HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Disabled（停用）" />
                                    <ComboBoxItem Content="RunKey（注册表自启）" />
                                    <ComboBoxItem Content="Tray（随管理器启动）" />
                                    <ComboBoxItem Content="Service（系统服务）" />
                                </ComboBox>

                                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                         Header="程序路径"
                                         PlaceholderText="C:\path\to\app.exe"
                                         Text="{Binding ExecutablePath, Mode=TwoWay}" />

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="24">
                                    <TextBox Header="参数" MinWidth="260"
                                             PlaceholderText="可选"
                                             Text="{Binding Arguments, Mode=TwoWay}" />
                                    <CheckBox Content="启动最小化" IsChecked="{Binding StartMinimized, Mode=TwoWay}" VerticalAlignment="Bottom" />
                                    <CheckBox Content="崩溃重启" IsChecked="{Binding RestartOnExit, Mode=TwoWay}" VerticalAlignment="Bottom" />
                                    <CheckBox Content="隐藏管理器图标" IsChecked="{Binding HideOwnTrayIcon, Mode=TwoWay}" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态引导 -->
            <StackPanel x:Name="EmptyState"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        HorizontalAlignment="Center"
                        Padding="28,20">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F4;" FontSize="42" />
                </Border>
                <TextBlock Text="还没有添加任何程序"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="把需要开机自启的 exe 加进来，Hidden Icons 会在登录时替你拉起它们；&#x0a;第三方软件的托盘图标请用右上角按钮去系统设置里隐藏。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           LineHeight="22" />
                <Button Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        Click="AddProfile_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="添加第一个程序" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
